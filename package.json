{
  "name": "tracksy-monorepo",
  "version": "1.0.0",
  "description": "TRACKSY - Smart Student Transport Tracking System - Monorepo",
  "private": true,
  "workspaces": [
    "studentapp",
    "admin-dashboard",
    "driver-app"
  ],
  "scripts": {
    "student:start": "cd studentapp && npm start",
    "student:android": "cd studentapp && npm run android",
    "student:ios": "cd studentapp && npm run ios",
    "admin:dev": "cd admin-dashboard && npm run dev",
    "admin:build": "cd admin-dashboard && npm run build",
    "driver:android": "cd driver-app && npm run android",
    "driver:start": "cd driver-app && npm start",
    "install:all": "npm install && cd studentapp && npm install && cd ../admin-dashboard && npm install && cd ../driver-app && npm install",
    "launcher:web": "http-server launcher -p 4000 -c-1 -s",
    "admin:web": "cd admin-dashboard && npm run web",
    "student:web": "cd studentapp && npm run web",
    "driver:web": "cd driver-app && npm run web",
    "web": "concurrently \"npm run launcher:web\" \"npm run admin:web\" \"npm run student:web\" \"npm run driver:web\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/tracksy.git"
  },
  "keywords": [
    "transport",
    "tracking",
    "student",
    "gps",
    "react-native",
    "remix"
  ],
  "author": "TRACKSY Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
